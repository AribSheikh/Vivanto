# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project's Environment Variables for production.
# Never commit real values.

# Shared password that gates the /admin slot-allocation panel.
ADMIN_PASSWORD=

# Neon Postgres connection string. Once you connect a Neon database to
# this project from the Vercel dashboard (Storage tab), Vercel injects
# this automatically for deployments -- you don't need to set it there
# yourself. For local development, leave this unset to use a JSON-file
# fallback (app/../lib/slotsStore.js), or paste the same connection
# string here to develop against the real database instead.
DATABASE_URL=
